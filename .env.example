JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_TTL_SECONDS=900
AUDIT_LOG_PATH=audit.log
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:2010/lms
PUBLIC_BASE_URL=https://lms.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Set true only when serving the app over HTTPS.
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Transactional outbox for enrollment confirmation emails.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY_SECONDS=2
OUTBOX_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=10
# 0 disables the in-process worker; drain with `flask outbox drain` instead.
OUTBOX_POLL_INTERVAL=0
